<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <base href="/" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="css/main.css" rel="stylesheet" />
    <script src="https://kit.fontawesome.com/8d656b7567.js" crossorigin="anonymous"></script>
    <HeadOutlet />
</head>
<body>
    <Routes @rendermode="RenderMode.InteractiveServer" />

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script>
        window.fetchVisitorIp = async (url) => {
            try {
                const response = await fetch(url);
                if (!response.ok) {
                    console.error('fetchVisitorIp: non-ok status', response.status);
                    return '';
                }
                const text = await response.text();
                try {
                    return JSON.parse(text);
                } catch {
                    return text;
                }
            } catch (e) {
                console.error('fetchVisitorIp: fetch error', e);
                return '';
            }
        };
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
